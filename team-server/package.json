{
  "name": "segreant-team-server",
  "version": "0.1.0",
  "private": true,
  "description": "Separate, optional, BYO-Postgres team server for Segreant's team tier. Segreant hosts nothing; operators run this on their own infrastructure. See team-server/README.md.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test:postgres": "node --disable-warning=ExperimentalWarning --test integration/postgres.test.ts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
